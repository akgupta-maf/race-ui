{
  "name": "@maf/race-ui",
  "version": "1.0.19",
  "description": "Internal shared React UI component library",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./theme": {
      "types": "./dist/styles.d.ts",
      "style": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npx @tailwindcss/cli -i src/styles/index.css -o dist/styles.css --minify && cp src/styles/theme.css dist/theme.css && echo 'declare const styles: string; export default styles;' > dist/styles.d.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@headlessui/react": ">=2",
    "clsx": ">=2",
    "lucide-react": ">=1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.10",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/MAFRetailDevOps/911f3a95-e1df-4498-97c5-5aa148a857f1/_packaging/maf-race/npm/registry/"
  }
}
